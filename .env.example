NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clothing_commerce_dev

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

JWT_ACCESS_SECRET=generate-a-long-random-secret
JWT_REFRESH_SECRET=generate-another-long-random-secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

JWT_ISSUER=clothing-commerce-api
JWT_AUDIENCE=clothing-commerce-web

AUTH_COOKIE_SAME_SITE=lax

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Use a separate long random secret for webhook signature verification
RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Online Order Reservation
ONLINE_ORDER_RESERVATION_TTL_MINUTES=30

# Online Order Reservation Expiry Worker
ONLINE_ORDER_RESERVATION_WORKER_INTERVAL_MS=10000
ONLINE_ORDER_RESERVATION_WORKER_BATCH_SIZE=25